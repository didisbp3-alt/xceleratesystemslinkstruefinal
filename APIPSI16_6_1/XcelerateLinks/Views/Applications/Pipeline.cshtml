@using System.Security.Claims
@{
    ViewData["Title"] = "Pipeline de Candidaturas";
    var companyId = ViewBag.CompanyId as int? ?? 0;
    var opportunityId = ViewBag.OpportunityId as int?;
    var applications = ViewBag.Applications as List<APIPSI16.Models.JobApplication> ?? new List<APIPSI16.Models.JobApplication>();
    var isAdmin = User.FindFirst(ClaimTypes.Role)?.Value == "0";
    var isEmployer = User.FindFirst(ClaimTypes.Role)?.Value == "2";
    var canManage = isAdmin || isEmployer;

    var stages = new (byte stage, string name, string color)[]
    {
        (0, "Enviada", "#6b7280"),
        (1, "Em análise", "#0052CC"),
        (2, "Entrevista", "#7c3aed"),
        (3, "Oferta", "#059669"),
        (4, "Aceite", "#10b981"),
        (5, "Recusada", "#ef4444")
    };
}

<style>
    .pipeline-page { max-width: 1200px; margin: 0 auto; }
    .pipeline-board { display: flex; gap: 1rem; overflow-x: auto; padding-bottom: 1rem; }
    .pipeline-column { min-width: 240px; flex-shrink: 0; border-radius: 12px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); }
    .pipeline-col-header { padding: 0.8rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.07); display: flex; align-items: center; justify-content: space-between; }
    .pipeline-col-label { font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
    .pipeline-col-count { background: rgba(255,255,255,0.1); border-radius: 20px; padding: 0.1rem 0.5rem; font-size: 0.72rem; }
    .pipeline-cards { padding: 0.6rem; display: flex; flex-direction: column; gap: 0.5rem; min-height: 80px; }
    .pipeline-app-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 9px; padding: 0.75rem 0.9rem; }
    .pipeline-app-card:hover { border-color: rgba(0,82,204,0.35); }
    .pac-name { font-size: 0.88rem; font-weight: 600; color: inherit; text-decoration: none; }
    .pac-name:hover { color: #4f8ef7; }
    .pac-opp { font-size: 0.75rem; color: var(--dark-text-muted,#a8b2c1); margin-top: 0.1rem; }
    .pac-date { font-size: 0.7rem; color: var(--dark-text-muted,#a8b2c1); margin-top: 0.3rem; }
    .pac-actions { margin-top: 0.5rem; display: flex; gap: 0.3rem; flex-wrap: wrap; }
    .pac-btn { font-size: 0.7rem; border: 1px solid rgba(255,255,255,0.12); background: transparent; color: inherit; border-radius: 5px; padding: 0.15rem 0.45rem; cursor: pointer; }
    .pac-btn:hover { background: rgba(255,255,255,0.07); }
    .pac-btn.active { background: #0052CC; border-color: #0052CC; color: #fff; }
</style>

<div class="container py-4">
    <div class="pipeline-page">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Manage" asp-controller="Companies" asp-route-id="@companyId" class="btn btn-sm btn-outline-secondary">← Gestão</a>
            <h2 class="mb-0">Pipeline de Candidaturas</h2>
            <span class="badge bg-secondary">@applications.Count candidatura(s)</span>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-warning mb-3">⚠️ @ViewBag.Error</div>
        }

        @if (!applications.Any())
        {
            <div style="text-align:center;padding:3rem;color:var(--dark-text-muted,#a8b2c1);">
                <p>Ainda não há candidaturas para esta empresa.</p>
            </div>
        }
        else
        {
            <div class="pipeline-board">
                @foreach (var (stage, stageName, stageColor) in stages)
                {
                    var stageApps = applications.Where(a => a.Status == stage).ToList();
                    <div class="pipeline-column">
                        <div class="pipeline-col-header">
                            <span class="pipeline-col-label" style="color: @stageColor">@stageName</span>
                            <span class="pipeline-col-count">@stageApps.Count</span>
                        </div>
                        <div class="pipeline-cards">
                            @foreach (var app in stageApps)
                            {
                                <div class="pipeline-app-card">
                                    <a asp-action="Details" asp-route-id="@app.JobApplicationId" class="pac-name">
                                        @(app.User?.Name ?? app.Name ?? $"Candidato #{app.UserId}")
                                    </a>
                                    <div class="pac-opp">@(app.Opportunity?.Title ?? $"Opp #{app.OpportunityId}")</div>
                                    <div class="pac-date">@app.AppliedAt.ToString("dd MMM yyyy")</div>

                                    @if (canManage)
                                    {
                                        <div class="pac-actions">
                                            @foreach (var (s, sn, sc) in stages)
                                            {
                                                if (s != stage)
                                                {
                                                    <form asp-action="UpdateStatus" method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@app.JobApplicationId" />
                                                        <input type="hidden" name="newStatus" value="@s" />
                                                        <input type="hidden" name="returnCompanyId" value="@companyId" />
                                                        <button type="submit" class="pac-btn" title="Mover para @sn">→@sn</button>
                                                    </form>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
